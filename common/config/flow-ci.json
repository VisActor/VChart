{
  "schemaVersion": 1,
  "kind": "trusted_ci_policy",
  "repository": "VisActor/VChart",
  "baseRef": "develop",
  "nodeMajor": 22,
  "rushVersion": "5.148.0",
  "pnpmVersion": "10.7.0",
  "unitPackages": [
    "vchart",
    "vchart-extension",
    "vchart-statplots",
    "vchart-schema",
    "vutils-extension"
  ],
  "buildTargets": [
    "@visactor/vchart",
    "@visactor/vchart-extension",
    "@visactor/vchart-statplots"
  ],
  "visualProduct": "vchart",
  "visualSelection": "full",
  "requiredChecks": [
    "VisActor Flow / Build",
    "VisActor Flow / Unit",
    "VisActor Flow / Repository visual"
  ],
  "firefoxPaste": false,
  "preBuildScripts": [
    {
      "package": "vchart-statplots",
      "script": "build:schema"
    }
  ],
  "visualSuites": [
    "core",
    "extension"
  ],
  "browserChecks": [
    {
      "package": "vchart-statplots",
      "config": "__tests__/browser/playwright.config.ts",
      "shards": 2
    }
  ],
  "buildFormats": [
    "es",
    "cjs"
  ],
  "nodeChecks": [
    "packages/vchart-statplots/__tests__/runtime/skill-resources.test.cjs",
    "packages/vchart-extension/__tests__/runtime/visual-build.test.cjs"
  ],
