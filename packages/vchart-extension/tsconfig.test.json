{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@visactor/vchart": ["../vchart/src/index.ts"],
      "eventemitter3": ["../vchart/node_modules/eventemitter3"],
      "@visactor/vrender": ["../vchart/node_modules/@visactor/vrender/es/index"],
      "@visactor/vrender/*": ["../vchart/node_modules/@visactor/vrender/es/*"],
      "@visactor/vrender-core": ["../vchart/node_modules/@visactor/vrender-core/es/index"],
      "@visactor/vrender-core/event/constant": [
        "../vchart/node_modules/@visactor/vrender-core/es/event/public-constant"
      ],
      "@visactor/vrender-core/*": ["../vchart/node_modules/@visactor/vrender-core/es/*"],
      "@visactor/vrender-animate": ["../vchart/node_modules/@visactor/vrender-animate/es/index"],
      "@visactor/vrender-animate/*": ["../vchart/node_modules/@visactor/vrender-animate/es/*"],
      "@visactor/vrender-components": ["../vchart/node_modules/@visactor/vrender-components/es/index"],
      "@visactor/vrender-components/*": ["../vchart/node_modules/@visactor/vrender-components/es/*"],
      "@visactor/vrender-kits": ["../vchart/node_modules/@visactor/vrender-kits/es/index"],
      "@visactor/vrender-kits/*": ["../vchart/node_modules/@visactor/vrender-kits/es/*"],
      "@visactor/vutils-extension": ["../vutils-extension/src"],
      "@visactor/vchart/esm/*": ["../vchart/src/*"],
      "src/*": ["../vchart/src/*"]
    }
  },
  "references": []
}
