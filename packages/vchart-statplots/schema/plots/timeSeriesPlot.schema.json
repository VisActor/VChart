            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "range"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind"
              ]
            },
            {
              "const": false,
              "type": "boolean"
            }
          ]
        }
      },
      "required": [
        "data",
        "input",
        "type"
      ]
    },
    {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "const": "observations"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimeSeriesObservation"
          }
        },
        "type": {
          "type": "string",
          "const": "timeSeriesPlot"
        },
        "fieldLabels": {
          "description": "字段的轴和 tooltip 展示名称；不改输入字段，不控制图元数据标签。",
          "type": "object",
          "properties": {
            "time": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "title": {
          "description": "图表标题。",
          "type": "string"
        },
        "description": {
          "description": "数据范围或统计方法说明。",
          "type": "string"
        },
        "theme": {
          "enum": [
            "dark",
            "light"
          ],
          "type": "string"
        },
        "colors": {
          "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
