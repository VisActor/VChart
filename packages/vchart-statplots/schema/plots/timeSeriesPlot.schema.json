                },
                "level": {
                  "type": "number"
                },
                "resamples": {
                  "type": "number"
                },
                "seed": {
                  "type": "number"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "percentile"
                },
                "level": {
                  "type": "number"
                }
              },
              "additionalProperties": false,
