{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "hexbinPlot"
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/HexbinPlotRow"
      }
    },
    "binning": {
      "description": "原始散点的分箱规则；重复坐标按多条观测计数。",
      "$ref": "#/definitions/HexbinBinningSpec"
    },
    "fieldLabels": {
      "description": "字段的轴和 tooltip 展示名称；不改输入字段，不控制图元数据标签。",
      "type": "object",
      "properties": {
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        },
        "count": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "title": {
      "description": "图表标题。",
      "type": "string"
    },
    "description": {
      "description": "数据范围或统计方法说明。",
      "type": "string"
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ],
      "type": "string"
    },
    "colors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "$ref": "#/definitions/StatPlotColors"
    }
  },
  "additionalProperties": false,
  "required": [
    "data",
    "type"
  ],
  "definitions": {
    "HexbinPlotRow": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "HexbinBinningSpec": {
      "type": "object",
      "properties": {
        "xBins": {
          "description": "水平方向的分箱分辨率，默认 30；不是非空箱总数，边缘可增加一列。",
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false
    },
    "StatPlotColors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "type": "object",
      "properties": {
        "categorical": {
          "description": "无序分组，默认 colorblind；vchart 使用原生主题分类色。",
          "anyOf": [
            {
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "colorblind",
                "deep",
                "vchart"
              ],
              "type": "string"
            }
          ]
        },
        "sequential": {
          "description": "从低到高，默认 viridis；数组停靠点等距。",
          "anyOf": [
            {
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "cividis",
                "viridis"
              ],
              "type": "string"
            }
          ]
        },
        "diverging": {
          "description": "从负到正，默认 RdBu_r（蓝→浅色→红）；数组中点对应统计中心。",
          "anyOf": [
            {
              "minItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "const": "RdBu_r",
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
