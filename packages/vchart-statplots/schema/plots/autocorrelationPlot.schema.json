{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "autocorrelationPlot"
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AutocorrelationPlotRow"
      }
    },
    "method": {
      "description": "默认 acf；pacf 采用 Yule–Walker MLE。",
      "enum": [
        "acf",
        "pacf"
      ],
      "type": "string"
    },
    "maxLag": {
      "description": "最高滞后，整数 1–512，另受每组样本量限制。",
      "type": "number"
    },
    "confidence": {
      "description": "默认 95% 零中心置信带；false 关闭。",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "level": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "const": false,
          "type": "boolean"
        }
      ]
    },
    "fieldLabels": {
      "type": "object",
      "properties": {
        "lag": {
          "type": "string"
        },
        "correlation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "title": {
      "description": "图表标题。",
      "type": "string"
    },
    "description": {
      "description": "数据范围或统计方法说明。",
      "type": "string"
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ],
      "type": "string"
    },
    "colors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "$ref": "#/definitions/StatPlotColors"
    }
  },
  "additionalProperties": false,
  "required": [
    "data",
    "type"
  ],
  "definitions": {
    "AutocorrelationPlotRow": {
      "description": "按每系列的输入顺序表示等间隔原始序列，不能按数值排序。",
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "series": {
          "description": "同一数据表要么全部提供系列名称，要么全部省略。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ]
    },
    "StatPlotColors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "type": "object",
      "properties": {
        "categorical": {
          "description": "无序分组，默认 colorblind；vchart 使用原生主题分类色。",
          "anyOf": [
            {
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "colorblind",
                "deep",
                "vchart"
              ],
              "type": "string"
            }
          ]
        },
        "sequential": {
          "description": "从低到高，默认 viridis；数组停靠点等距。",
          "anyOf": [
            {
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "cividis",
                "viridis"
              ],
              "type": "string"
            }
          ]
        },
        "diverging": {
          "description": "从负到正，默认 RdBu_r（蓝→浅色→红）；数组中点对应统计中心。",
          "anyOf": [
            {
              "minItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "const": "RdBu_r",
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
