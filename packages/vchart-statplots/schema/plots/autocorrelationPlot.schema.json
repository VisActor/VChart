{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "autocorrelationPlot"
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AutocorrelationPlotRow"
      }
    },
    "method": {
      "description": "外部计算方法或结果类型说明；本包不重新拟合或估计。",
      "enum": [
        "acf",
        "pacf"
      ],
      "type": "string"
    },
    "interval": {
      "description": "显示区间的统计含义；数值由计算端提供。",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "confidence",
                "credible",
                "prediction"
              ],
              "type": "string"
            },
            "level": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "level"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "standardDeviation",
                "standardError"
              ],
              "type": "string"
            },
            "multiplier": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "multiplier"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "range"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "fieldLabels": {
      "description": "字段的轴和 tooltip 展示名称；不改输入字段，不控制图元数据标签。",
      "type": "object",
      "properties": {
        "lag": {
          "type": "string"
        },
        "correlation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "title": {
      "description": "图表标题。",
      "type": "string"
    },
    "description": {
      "description": "数据范围或统计方法说明。",
      "type": "string"
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ],
      "type": "string"
    },
    "colors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "$ref": "#/definitions/StatPlotColors"
    }
  },
  "additionalProperties": false,
  "required": [
    "data",
    "method",
    "type"
  ],
  "definitions": {
    "AutocorrelationPlotRow": {
      "description": "统计量由调用方计算；只负责可视化。",
      "type": "object",
      "properties": {
        "lag": {
          "type": "number"
        },
        "correlation": {
          "description": "外部 ACF/PACF 估计值；保留无偏估计可能超出 [-1,1] 的结果。",
          "type": "number"
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "series": {
          "description": "同一数据表要么全部提供系列名称，要么全部省略。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "correlation",
        "lag"
      ]
    },
    "StatPlotColors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "type": "object",
      "properties": {
        "categorical": {
          "description": "无序分组，默认 colorblind；vchart 使用原生主题分类色。",
          "anyOf": [
            {
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "colorblind",
                "deep",
                "vchart"
              ],
              "type": "string"
            }
          ]
        },
        "sequential": {
          "description": "从低到高，默认 viridis；数组停靠点等距。",
          "anyOf": [
            {
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "cividis",
                "viridis"
              ],
              "type": "string"
            }
          ]
        },
        "diverging": {
          "description": "从负到正，默认 RdBu_r（蓝→浅色→红）；数组中点对应统计中心。",
          "anyOf": [
            {
              "minItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "const": "RdBu_r",
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
