{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "calibrationCurve"
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CalibrationCurveRow"
      }
    },
    "interval": {
      "description": "显示区间的统计含义；数值由计算端提供。",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "confidence",
                "credible",
                "prediction"
              ],
              "type": "string"
            },
            "level": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "level"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "standardDeviation",
                "standardError"
              ],
              "type": "string"
            },
            "multiplier": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "multiplier"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "range"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "fieldLabels": {
      "description": "字段的轴和 tooltip 展示名称；不改输入字段，不控制图元数据标签。",
      "type": "object",
      "properties": {
        "meanPredictedProbability": {
          "type": "string"
        },
        "observedRate": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "title": {
      "description": "图表标题。",
      "type": "string"
    },
    "description": {
      "description": "数据范围或统计方法说明。",
      "type": "string"
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ],
      "type": "string"
    },
    "colors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "$ref": "#/definitions/StatPlotColors"
    }
  },
  "additionalProperties": false,
  "required": [
    "data",
    "type"
  ],
  "definitions": {
    "CalibrationCurveRow": {
      "description": "预计算统计结果；本包不拟合模型。",
      "type": "object",
      "properties": {
        "binStart": {
          "type": "number"
        },
        "binEnd": {
          "type": "number"
        },
        "meanPredictedProbability": {
          "description": "箱内平均预测概率，0–1，必须位于 binStart 与 binEnd 内。",
          "type": "number"
        },
        "observedRate": {
          "description": "箱内实际正例比例，范围 0–1。",
          "type": "number"
        },
        "count": {
          "type": "number"
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "series": {
          "description": "同一数据表要么全部提供系列名称，要么全部省略。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "binEnd",
        "binStart",
        "count",
        "meanPredictedProbability",
        "observedRate"
      ]
    },
    "StatPlotColors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "type": "object",
      "properties": {
        "categorical": {
          "description": "无序分组，默认 colorblind；vchart 使用原生主题分类色。",
          "anyOf": [
            {
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "colorblind",
                "deep",
                "vchart"
              ],
              "type": "string"
            }
          ]
        },
        "sequential": {
          "description": "从低到高，默认 viridis；数组停靠点等距。",
          "anyOf": [
            {
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "cividis",
                "viridis"
              ],
              "type": "string"
            }
          ]
        },
        "diverging": {
          "description": "从负到正，默认 RdBu_r（蓝→浅色→红）；数组中点对应统计中心。",
          "anyOf": [
            {
              "minItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "const": "RdBu_r",
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
