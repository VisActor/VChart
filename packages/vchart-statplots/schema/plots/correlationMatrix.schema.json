{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "correlationMatrix"
    },
    "data": {
      "description": "完整的对称矩阵；triangle 只影响显示。",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CorrelationMatrixRow"
      }
    },
    "method": {
      "description": "外部计算方法或结果类型说明；本包不重新拟合或估计。",
      "enum": [
        "kendall",
        "pearson",
        "spearman"
      ],
      "type": "string"
    },
    "triangle": {
      "description": "显示完整矩阵或指定三角，默认 full；输入仍须完整对称。",
      "enum": [
        "full",
        "lower",
        "upper"
      ],
      "type": "string"
    },
    "variableOrder": {
      "description": "完整变量显示顺序；每个变量恰好出现一次，默认按数据首次出现排序。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fieldLabels": {
      "description": "字段的轴和 tooltip 展示名称；不改输入字段，不控制图元数据标签。",
      "type": "object",
      "properties": {
        "row": {
          "type": "string"
        },
        "column": {
          "type": "string"
        },
        "correlation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "title": {
      "description": "图表标题。",
      "type": "string"
    },
    "description": {
      "description": "数据范围或统计方法说明。",
      "type": "string"
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ],
      "type": "string"
    },
    "colors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "$ref": "#/definitions/StatPlotColors"
    }
  },
  "additionalProperties": false,
  "required": [
    "data",
    "method",
    "type"
  ],
  "definitions": {
    "CorrelationMatrixRow": {
      "type": "object",
      "properties": {
        "row": {
          "type": "string"
        },
        "column": {
          "type": "string"
        },
        "correlation": {
          "description": "相关系数，-1 至 1；无法计算时为 null。",
          "type": [
            "null",
            "number"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "column",
        "correlation",
        "row"
      ]
    },
    "StatPlotColors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "type": "object",
      "properties": {
        "categorical": {
          "description": "无序分组，默认 colorblind；vchart 使用原生主题分类色。",
          "anyOf": [
            {
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "colorblind",
                "deep",
                "vchart"
              ],
              "type": "string"
            }
          ]
        },
        "sequential": {
          "description": "从低到高，默认 viridis；数组停靠点等距。",
          "anyOf": [
            {
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "cividis",
                "viridis"
              ],
              "type": "string"
            }
          ]
        },
        "diverging": {
          "description": "从负到正，默认 RdBu_r（蓝→浅色→红）；数组中点对应统计中心。",
          "anyOf": [
            {
              "minItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "const": "RdBu_r",
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
