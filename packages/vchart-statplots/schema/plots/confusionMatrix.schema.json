{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "confusionMatrix"
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ConfusionMatrixRow"
      }
    },
    "classOrder": {
      "description": "完整显示顺序；可包含本批未出现类别，须覆盖所有输入类别。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normalization": {
      "description": "默认 none；actual 按实际类别、predicted 按预测类别、all 按全部计数归一化。",
      "enum": [
        "actual",
        "all",
        "none",
        "predicted"
      ],
      "type": "string"
    },
    "fieldLabels": {
      "description": "字段的轴和 tooltip 展示名称；不改输入字段，不控制图元数据标签。",
      "type": "object",
      "properties": {
        "actual": {
          "type": "string"
        },
        "predicted": {
          "type": "string"
        },
        "count": {
          "type": "string"
        },
        "proportion": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "title": {
      "description": "图表标题。",
      "type": "string"
    },
    "description": {
      "description": "数据范围或统计方法说明。",
      "type": "string"
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ],
      "type": "string"
    },
    "colors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "$ref": "#/definitions/StatPlotColors"
    }
  },
  "additionalProperties": false,
  "required": [
    "data",
    "type"
  ],
  "definitions": {
    "ConfusionMatrixRow": {
      "description": "每行是一条实际类别与预测类别观测，内部计数。",
      "type": "object",
      "properties": {
        "actual": {
          "type": "string"
        },
        "predicted": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "actual",
        "predicted"
      ]
    },
    "StatPlotColors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "type": "object",
      "properties": {
        "categorical": {
          "description": "无序分组，默认 colorblind；vchart 使用原生主题分类色。",
          "anyOf": [
            {
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "colorblind",
                "deep",
                "vchart"
              ],
              "type": "string"
            }
          ]
        },
        "sequential": {
          "description": "从低到高，默认 viridis；数组停靠点等距。",
          "anyOf": [
            {
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "cividis",
                "viridis"
              ],
              "type": "string"
            }
          ]
        },
        "diverging": {
          "description": "从负到正，默认 RdBu_r（蓝→浅色→红）；数组中点对应统计中心。",
          "anyOf": [
            {
              "minItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "const": "RdBu_r",
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
