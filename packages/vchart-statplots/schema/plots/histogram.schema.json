{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "histogram"
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/HistogramRow"
      }
    },
    "binning": {
      "description": "原始观测的分箱规则；重复值分别计数。",
      "$ref": "#/definitions/HistogramBinningSpec"
    },
    "statistic": {
      "description": "显示统计量，默认 count；proportion 为样本比例，density 为单位数值区间的概率密度。",
      "enum": [
        "count",
        "density",
        "proportion"
      ],
      "type": "string"
    },
    "fieldLabels": {
      "description": "字段的轴和 tooltip 展示名称；不改输入字段，不控制图元数据标签。",
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "count": {
          "type": "string"
        },
        "proportion": {
          "type": "string"
        },
        "density": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "title": {
      "description": "图表标题。",
      "type": "string"
    },
    "description": {
      "description": "数据范围或统计方法说明。",
      "type": "string"
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ],
      "type": "string"
    },
    "colors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "$ref": "#/definitions/StatPlotColors"
    }
  },
  "additionalProperties": false,
  "required": [
    "data",
    "type"
  ],
  "definitions": {
    "HistogramRow": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ]
    },
    "HistogramBinningSpec": {
      "type": "object",
      "properties": {
        "binCount": {
          "description": "非恒定数据的等宽箱数；省略时按样本量选择。",
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false
    },
    "StatPlotColors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "type": "object",
      "properties": {
        "categorical": {
          "description": "无序分组，默认 colorblind；vchart 使用原生主题分类色。",
          "anyOf": [
            {
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "colorblind",
                "deep",
                "vchart"
              ],
              "type": "string"
            }
          ]
        },
        "sequential": {
          "description": "从低到高，默认 viridis；数组停靠点等距。",
          "anyOf": [
            {
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "cividis",
                "viridis"
              ],
              "type": "string"
            }
          ]
        },
        "diverging": {
          "description": "从负到正，默认 RdBu_r（蓝→浅色→红）；数组中点对应统计中心。",
          "anyOf": [
            {
              "minItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "const": "RdBu_r",
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
