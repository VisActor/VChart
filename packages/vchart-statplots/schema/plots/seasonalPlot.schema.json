{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "seasonalPlot"
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SeasonalPlotRow"
      }
    },
    "cycleOrder": {
      "description": "非空、无重复，覆盖输入的周期；可声明无观测的位置。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phaseOrder": {
      "description": "非空、无重复，覆盖输入的周期内位置；可声明无观测的位置。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layout": {
      "description": "默认 overlay；subseries 按 phase 分面、横轴为 cycle。",
      "enum": [
        "overlay",
        "subseries"
      ],
      "type": "string"
    },
    "fieldLabels": {
      "description": "字段的轴和 tooltip 展示名称；不改输入字段，不控制图元数据标签。",
      "type": "object",
      "properties": {
        "cycle": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "title": {
      "description": "图表标题。",
      "type": "string"
    },
    "description": {
      "description": "数据范围或统计方法说明。",
      "type": "string"
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ],
      "type": "string"
    },
    "colors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "$ref": "#/definitions/StatPlotColors"
    }
  },
  "additionalProperties": false,
  "required": [
    "cycleOrder",
    "data",
    "phaseOrder",
    "type"
  ],
  "definitions": {
    "SeasonalPlotRow": {
      "description": "统计量由调用方计算；只负责可视化。",
      "type": "object",
      "properties": {
        "cycle": {
          "description": "完整周期编号，例如年份。",
          "type": "string"
        },
        "phase": {
          "description": "周期内位置，例如月份或季度。",
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "series": {
          "description": "同一数据表要么全部提供系列名称，要么全部省略。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "cycle",
        "phase",
        "value"
      ]
    },
    "StatPlotColors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "type": "object",
      "properties": {
        "categorical": {
          "description": "无序分组，默认 colorblind；vchart 使用原生主题分类色。",
          "anyOf": [
            {
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "colorblind",
                "deep",
                "vchart"
              ],
              "type": "string"
            }
          ]
        },
        "sequential": {
          "description": "从低到高，默认 viridis；数组停靠点等距。",
          "anyOf": [
            {
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "cividis",
                "viridis"
              ],
              "type": "string"
            }
          ]
        },
        "diverging": {
          "description": "从负到正，默认 RdBu_r（蓝→浅色→红）；数组中点对应统计中心。",
          "anyOf": [
            {
              "minItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "const": "RdBu_r",
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
