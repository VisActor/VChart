{
  "anyOf": [
    {
      "$ref": "#/definitions/PointIntervalObservationsSpec"
    },
    {
      "$ref": "#/definitions/PointIntervalEstimatesSpec"
    }
  ],
  "definitions": {
    "PointIntervalObservationsSpec": {
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "const": "observations"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PointIntervalObservation"
          }
        },
        "estimator": {
          "enum": [
            "mean",
            "median"
          ],
          "type": "string"
        },
        "errorBar": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "confidence"
                },
                "level": {
                  "type": "number"
                },
                "resamples": {
                  "type": "number"
                },
                "seed": {
                  "type": "number"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "percentile"
                },
                "level": {
                  "type": "number"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "standardError"
                },
                "multiplier": {
                  "type": "number"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "standardDeviation"
                },
                "multiplier": {
                  "type": "number"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "range"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind"
              ]
            },
            {
              "const": false,
              "type": "boolean"
            }
          ]
        },
        "type": {
          "type": "string",
          "const": "pointIntervalPlot"
        },
        "referenceLine": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "value"
          ]
        },
        "valueScale": {
          "enum": [
            "linear",
            "log"
          ],
          "type": "string"
        },
        "fieldLabels": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string"
            },
            "estimate": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "title": {
          "description": "图表标题。",
          "type": "string"
        },
        "description": {
          "description": "数据范围或统计方法说明。",
          "type": "string"
        },
        "theme": {
          "enum": [
            "dark",
            "light"
          ],
          "type": "string"
        },
        "colors": {
          "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
          "$ref": "#/definitions/StatPlotColors"
        }
      },
      "additionalProperties": false,
      "required": [
        "data",
        "input",
        "type"
      ]
    },
    "PointIntervalObservation": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "series": {
          "description": "同一数据表要么全部提供系列名称，要么全部省略。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "category",
        "value"
      ]
    },
    "StatPlotColors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "type": "object",
      "properties": {
        "categorical": {
          "description": "无序分组，默认 colorblind；vchart 使用原生主题分类色。",
          "anyOf": [
            {
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "colorblind",
                "deep",
                "vchart"
              ],
              "type": "string"
            }
          ]
        },
        "sequential": {
          "description": "从低到高，默认 viridis；数组停靠点等距。",
          "anyOf": [
            {
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "cividis",
                "viridis"
              ],
              "type": "string"
            }
          ]
        },
        "diverging": {
          "description": "从负到正，默认 RdBu_r（蓝→浅色→红）；数组中点对应统计中心。",
          "anyOf": [
            {
              "minItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "const": "RdBu_r",
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "PointIntervalEstimatesSpec": {
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "const": "estimates"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PointIntervalPlotRow"
          }
        },
        "interval": {
          "$ref": "#/definitions/Interval"
        },
        "type": {
          "type": "string",
          "const": "pointIntervalPlot"
        },
        "referenceLine": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "value"
          ]
        },
        "valueScale": {
          "enum": [
            "linear",
            "log"
          ],
          "type": "string"
        },
        "fieldLabels": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string"
            },
            "estimate": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "title": {
          "description": "图表标题。",
          "type": "string"
        },
        "description": {
          "description": "数据范围或统计方法说明。",
          "type": "string"
        },
        "theme": {
          "enum": [
            "dark",
            "light"
          ],
          "type": "string"
        },
        "colors": {
          "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
          "$ref": "#/definitions/StatPlotColors"
        }
      },
      "additionalProperties": false,
      "required": [
        "data",
        "input",
        "interval",
        "type"
      ]
    },
    "PointIntervalPlotRow": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
        },
        "estimate": {
          "type": "number"
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "series": {
          "description": "同一数据表要么全部提供系列名称，要么全部省略。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "category",
        "estimate",
        "lower",
        "upper"
      ]
    },
    "Interval": {
      "description": "显示区间的统计含义；数值由计算端提供。",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "confidence",
                "credible",
                "prediction"
              ],
              "type": "string"
            },
            "level": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "level"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "standardDeviation",
                "standardError"
              ],
              "type": "string"
            },
            "multiplier": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "multiplier"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "range"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "const": "pointIntervalPlot"
    }
  },
  "required": [
    "type",
    "input"
  ]
}
