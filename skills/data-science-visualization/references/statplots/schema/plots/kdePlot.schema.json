{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "kdePlot"
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/KdePlotRow"
      }
    },
    "estimation": {
      "description": "编译阶段的核密度估计配置。单样本和常数系列须显式提供正带宽。",
      "$ref": "#/definitions/KdeEstimationSpec"
    },
    "sampling": {
      "description": "绘制采样配置；不改变估计方法和带宽。",
      "$ref": "#/definitions/KdeSamplingSpec"
    },
    "normalizationScope": {
      "description": "默认 all 按组样本比例缩放密度；series 各组概率密度独立积分为 1。",
      "enum": [
        "all",
        "series"
      ],
      "type": "string"
    },
    "fieldLabels": {
      "description": "字段的轴和 tooltip 展示名称；不改输入字段，不控制图元数据标签。",
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "density": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "title": {
      "description": "图表标题。",
      "type": "string"
    },
    "description": {
      "description": "数据范围或统计方法说明。",
      "type": "string"
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ],
      "type": "string"
    },
    "colors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "$ref": "#/definitions/StatPlotColors"
    }
  },
  "additionalProperties": false,
  "required": [
    "data",
    "type"
  ],
  "definitions": {
    "KdePlotRow": {
      "type": "object",
      "properties": {
        "value": {
          "description": "原始观测；重复值分别参与估计。",
          "type": "number"
        },
        "series": {
          "description": "同一数据表要么全部提供系列名称，要么全部省略。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ]
    },
    "KdeEstimationSpec": {
      "type": "object",
      "properties": {
        "kernel": {
          "description": "默认 gaussian。",
          "enum": [
            "epanechnikov",
            "gaussian"
          ],
          "type": "string"
        },
        "bandwidth": {
          "description": "正数为固定带宽，单位与 value 相同；默认 scott，各分布组独立估计。",
          "anyOf": [
            {
              "enum": [
                "scott",
                "silverman"
              ],
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "standardDeviation": {
          "description": "自动带宽的标准差约定，默认 sample；固定数值带宽时不能配置。",
          "enum": [
            "population",
            "sample"
          ],
          "type": "string"
        },
        "bandwidthAdjust": {
          "description": "正的带宽倍率，默认 1，同时作用于固定和自动带宽。",
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "KdeSamplingSpec": {
      "type": "object",
      "properties": {
        "points": {
          "description": "每组等距绘制点数，默认 256；仅控制曲线离散精度。",
          "type": "integer",
          "minimum": 2,
          "maximum": 2048
        },
        "cut": {
          "description": "从观测极值向外扩展的带宽倍数；KDE 高斯默认 3，violin 高斯默认 2，Epanechnikov 默认 1。",
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "StatPlotColors": {
      "description": "全图共用的颜色角色；省略时使用各角色默认色板。",
      "type": "object",
      "properties": {
        "categorical": {
          "description": "无序分组，默认 colorblind；vchart 使用原生主题分类色。",
          "anyOf": [
            {
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "colorblind",
                "deep",
                "vchart"
              ],
              "type": "string"
            }
          ]
        },
        "sequential": {
          "description": "从低到高，默认 viridis；数组停靠点等距。",
          "anyOf": [
            {
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "enum": [
                "cividis",
                "viridis"
              ],
              "type": "string"
            }
          ]
        },
        "diverging": {
          "description": "从负到正，默认 RdBu_r（蓝→浅色→红）；数组中点对应统计中心。",
          "anyOf": [
            {
              "minItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "type": "array"
            },
            {
              "const": "RdBu_r",
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
