{
  "name": "@visactor/vchart-statplots",
  "version": "2.1.8-alpha.0",
  "description": "Semantic statistical graphics for data science, powered by VChart",
  "sideEffects": false,
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "types": "esm/index.d.ts",
  "unpkg": "build/index.min.js",
  "files": [
    "cjs",
    "esm",
    "build",
    "schema",
    "examples",
    "docs",
    "README.md",
    "THIRD_PARTY_LICENSES.md",
    "benchmarks"
  ],
  "peerDependencies": {
    "@visactor/vchart": "2.1.7"
  },
  "dependencies": {
    "@visactor/vutils": "~1.0.27"
  },
  "devDependencies": {
    "@visactor/vchart": "2.1.8-alpha.0",
    "@rushstack/eslint-patch": "~1.1.4",
    "@types/node": "*",
    "@types/jest": "^26.0.0",
    "@types/offscreencanvas": "2019.6.4",
    "@playwright/test": "1.63.0",
    "ajv": "^8.12.0",
    "eslint": "~8.18.0",
    "jest": "^26.0.0",
    "ts-jest": "^26.0.0",
    "ts-node": "10.9.0",
    "typescript": "4.9.5",
    "vite": "3.2.6",
    "@internal/typescript-json-schema": "0.0.1",
    "@internal/bundler": "0.0.1",
    "@internal/eslint-config": "0.0.1",
    "@internal/ts-config": "0.0.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VisActor/VChart",
    "directory": "packages/vchart-statplots"
  },
  "license": "MIT",
  "scripts": {
    "build:schema": "ts-node scripts/build-schema.ts",
    "check:schema": "ts-node scripts/build-schema.ts --check",
    "check:examples": "ts-node scripts/check-examples.ts",
    "compile": "tsc --noEmit",
    "eslint": "eslint src scripts __tests__ --ext .ts",
    "test": "jest",
    "test:browser": "playwright test --config __tests__/browser/playwright.config.ts",
    "build": "npm run build:schema && npm run compile && bundle --clean",
    "build:umd": "bundle -f umd",
    "start": "vite --host 127.0.0.1",
    "check:catalog": "ts-node scripts/check-catalog.ts"
  }
}